{
    "name": "nightinker/laravel-snailmark",
    "type": "library",
    "description": "Laravel mail transport for sending email via the Snailmark API.",
    "keywords": [
        "snailmark",
        "laravel",
        "mail",
        "email",
        "transactional"
    ],
    "homepage": "https://github.com/nightinker/laravel-snailmark",
    "license": "MIT",
    "authors": [
        {
            "name": "Harlequin Doyon"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Snailmark\\Mail\\SnailmarkServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Snailmark\\Mail\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Snailmark\\Mail\\Tests\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
